rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function dangNhap() { return request.auth != null; }
    function vaiTro() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vaiTro; }
    function laNhanVien() { return dangNhap() && vaiTro() == 'nhan_vien'; }
    function laCH() { return dangNhap() && vaiTro() == 'chu_cua_hang'; }
    function laQT() { return dangNhap() && vaiTro() == 'quan_tri'; }
    function laBanHang() { return laNhanVien() || laCH(); }

    match /users/{uid} {
      allow read: if dangNhap() && (
        request.auth.uid == uid || laQT() || laCH()
        || (laNhanVien() && resource.data.vaiTro == 'khach_hang')
      );

      allow create: if dangNhap() && (
        (request.auth.uid == uid && request.resource.data.vaiTro == 'khach_hang') || laQT()
      );
      allow update: if dangNhap() && (
        (laQT() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vaiTro', 'trangThai']))
        || (laCH() && resource.data.vaiTro != 'khach_hang'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['chucVu', 'luongCoBan']))
        || (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hoTen', 'soDienThoai', 'diaChi']))
      );
      allow delete: if laQT();
    }

    match /sanpham/{id} {
      allow read: if true;
      allow create, delete: if laCH();
      allow update: if laCH()
        || (laBanHang()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soLuongTon'])
          && request.resource.data.soLuongTon >= 0)
        || (dangNhap()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soLuongTon'])
          && request.resource.data.soLuongTon >= 0
          && request.resource.data.soLuongTon < resource.data.soLuongTon);
    }

    match /danhmuc/{id} { allow read: if true; allow write: if laCH(); }
    match /cauhinh/{id} { allow read: if true; allow write: if laCH(); }
    match /nhacungcap/{id} { allow read, write: if laCH(); }

    match /bopc/{id} {
      allow read: if resource.data.hienThi == true || laCH();
      allow create, update: if laCH()
        && request.resource.data.ten.size() > 0 && request.resource.data.ten.size() <= 80
        && request.resource.data.linhKien.size() >= 2 && request.resource.data.linhKien.size() <= 20;
      allow delete: if laCH();
    }

    match /donhang/{id} {
      allow read: if dangNhap() && (resource.data.khachHangId == request.auth.uid || laBanHang());
      allow create: if dangNhap() && request.resource.data.khachHangId == request.auth.uid
        && request.resource.data.trangThai == 'cho_duyet';
      allow update: if laBanHang()
        // Khách chỉ được gửi yêu cầu huỷ khi đơn đang chờ duyệt; nhân viên xác nhận và hoàn kho
        || (dangNhap()
            && resource.data.khachHangId == request.auth.uid
            && resource.data.trangThai == 'cho_duyet'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['yeuCauHuy']));
    }

    match /chitietdonhang/{id} {
      allow read: if dangNhap() && (laBanHang() || resource.data.khachHangId == request.auth.uid);
      allow create: if dangNhap()
        && request.resource.data.khachHangId == request.auth.uid
        && getAfter(/databases/$(database)/documents/donhang/$(request.resource.data.donHangId)).data.khachHangId == request.auth.uid;
      allow update, delete: if laBanHang();
    }

    match /giohang/{id} {
      allow read, update, delete: if dangNhap() && resource.data.khachHangId == request.auth.uid;
      allow create: if dangNhap() && request.resource.data.khachHangId == request.auth.uid;
    }

    match /danhgia/{id} {
      allow read: if true;
      allow create: if dangNhap() && vaiTro() == 'khach_hang'
        && request.resource.data.khachHangId == request.auth.uid
        && request.resource.data.soSao in [1, 2, 3, 4, 5]
        && request.resource.data.noiDung.size() <= 1000;
      allow update: if dangNhap() && resource.data.khachHangId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['soSao', 'noiDung'])
        && request.resource.data.soSao in [1, 2, 3, 4, 5]
        && request.resource.data.noiDung.size() <= 1000;
      allow delete: if dangNhap() && resource.data.khachHangId == request.auth.uid;
    }

    match /chamcong/{id} {
      allow read: if dangNhap() && (resource.data.nhanVienId == request.auth.uid || laCH());
      allow create: if dangNhap() && request.resource.data.nhanVienId == request.auth.uid;
      allow update: if dangNhap() && (
        laCH() || 
        (resource.data.nhanVienId == request.auth.uid 
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gioRa', 'trangThai']))
      );
      allow delete: if laCH();
    }

    match /luongthuong/{id} {
      allow read: if dangNhap() && (resource.data.nhanVienId == request.auth.uid || laCH());
      allow write: if laCH();
    }

    match /yeucauhotro/{id} {
      allow read: if dangNhap() && (resource.data.khachHangId == request.auth.uid || laBanHang());
      allow create: if dangNhap() && request.resource.data.khachHangId == request.auth.uid;
      allow update: if laCH()
        || (laNhanVien() && (
          (resource.data.get('nhanVienId', null) == null
            && request.resource.data.nhanVienId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nhanVienId', 'nhanVienTen', 'ngayTiepNhan', 'trangThai']))
          || (resource.data.get('nhanVienId', null) == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nhanVienId', 'nhanVienTen', 'trangThai', 'phanHoi', 'nhanVienXuLyId'])
            && request.resource.data.nhanVienId in [null, request.auth.uid])
        ));
    }

    match /tuvan/{id} {
      allow read: if dangNhap() && (resource.data.khachHangId == request.auth.uid || laBanHang());
      allow create: if dangNhap() && vaiTro() == 'khach_hang'
        && request.resource.data.khachHangId == request.auth.uid
        && request.resource.data.trangThai == 'cho'
        && request.resource.data.nhanVienId == null;
      allow update: if laCH()
        || (dangNhap()
          && resource.data.khachHangId == request.auth.uid
          && resource.data.trangThai != 'da_dong'
          && request.resource.data.trangThai == 'da_dong'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'ngayDong']))
        || (laNhanVien() && (
          (resource.data.trangThai == 'cho'
            && request.resource.data.trangThai == 'dang_chat'
            && request.resource.data.nhanVienId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'nhanVienId', 'nhanVienTen', 'ngayTiepNhan']))
          || (resource.data.trangThai == 'dang_chat'
            && resource.data.nhanVienId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trangThai', 'nhanVienId', 'nhanVienTen', 'ngayDong'])
            && ((request.resource.data.trangThai == 'da_dong' && request.resource.data.nhanVienId == request.auth.uid)
              || (request.resource.data.trangThai == 'cho' && request.resource.data.nhanVienId == null)))
        ));
    }

    match /tuvan/{id}/tinnhan/{mid} {
      allow read: if dangNhap()
        && (get(/databases/$(database)/documents/tuvan/$(id)).data.khachHangId == request.auth.uid || laBanHang());
      allow create: if dangNhap()
        && request.resource.data.nguoiGuiId == request.auth.uid
        && request.resource.data.noiDung.size() > 0
        && request.resource.data.noiDung.size() <= 1000
        && get(/databases/$(database)/documents/tuvan/$(id)).data.trangThai != 'da_dong'
        && (
          (get(/databases/$(database)/documents/tuvan/$(id)).data.khachHangId == request.auth.uid
            && request.resource.data.vaiTro == 'khach')
          || (laNhanVien()
            && get(/databases/$(database)/documents/tuvan/$(id)).data.nhanVienId == request.auth.uid
            && request.resource.data.vaiTro == 'nhan_vien')
          || (laCH() && request.resource.data.vaiTro == 'chu')
        );
      allow update, delete: if false;
    }

    match /nhatky/{id} {
      allow read: if laQT() || laCH();
      allow create: if dangNhap() && request.resource.data.nguoiThucHienId == request.auth.uid;
    }
  }
}
